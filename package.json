{
  "name": "crazy-zombie-v10",
  "version": "10.0.0",
  "author": "BaoNam324",
  "description": "Crazy Zombie 10.0 — Fanmade Studio Edition (Ruffle Rust/WASM Engine + Original Mike.swf + v10.0 Expansion)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/copy-ruffle.cjs",
    "preview": "vite preview",
    "electron:dev": "npm run build && electron .",
    "build:exe": "npm run build && electron-builder --win zip --publish never"
  },
  "dependencies": {
    "@ruffle-rs/ruffle": "latest",
    "@supabase/supabase-js": "^2.49.1",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "com.baonam324.crazyzombie10",
    "productName": "Crazy Zombie 10.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "zip"
      ]
    }
  }
}
