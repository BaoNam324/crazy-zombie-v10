{
  "name": "crazy-zombie-v10",
  "version": "10.0.0",
  "author": "BaoNam324",
  "description": "Crazy Zombie 10.0 — 2.5D Arcade Beat 'em Up (Phaser 3 + TypeScript + Electron + Supabase)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "build:exe": "tsc --noEmit && vite build && electron-builder --win portable nsis"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "com.baonam324.crazyzombie10",
    "productName": "Crazy Zombie 10.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "portable",
        "nsis"
      ]
    }
  }
}
